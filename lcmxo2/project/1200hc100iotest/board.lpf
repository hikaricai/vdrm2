# LCMXO2-1200HC-4TG100C: all user IO except the four JTAG pins.
# Source: ../mbi5264/FPGA-SC-02009-1-44-MachXO2-1200-Pinout.csv, TQFP100.
# TMS=90, TCK=91, TDI=94, TDO=95 remain reserved for programming.
# All VCCIO banks must be powered at 3.3 V before using this bitstream.
# io index increases with physical pin number, including configuration IO.

SYSCONFIG SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=DISABLE;

LOCATE COMP "io[0]" SITE "1"; IOBUF PORT "io[0]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "io[1]" SITE "2"; IOBUF PORT "io[1]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
