# LCMXO2-2000HC-4TG144I: all user IO except the four JTAG pins.
# TMS=130, TCK=131, TDI=136, and TDO=137 remain reserved for programming.
# All VCCIO banks must be powered at 3.3 V before using this bitstream.

SYSCONFIG SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=DISABLE;

