# LCMXO2-1200HC-4TG100C.
# Source: SCH_Schematic5_2026-11-21.pdf, U1, sheet 1.
# Physical TQFP100 pin numbers; all VCCIO connected to 3.3 V.
# Bus index 0..5 maps to schematic suffix 1,3,5,7,9,11.

LOCATE COMP "CLK" SITE "35"; IOBUF PORT "CLK" IO_TYPE=LVCMOS33;
LOCATE COMP "SEL[0]" SITE "88"; IOBUF PORT "SEL[0]" IO_TYPE=LVCMOS33;
