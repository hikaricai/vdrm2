# LCMXO2-2000HC-4TG144C (actual board device).
# Wiring source: ../LCMXO21200hc_SCH_Schematic3_2026-09-30.pdf, sheet 1.
# Physical IO pins checked against the LCMXO2-2000 TQFP144 migration table.
# Every SITE is a physical TQFP144 pin; array index 0 is schematic suffix 1.
# 3.3 V MCU/display interface: all connected VCCIO banks must use 3.3 V.

LOCATE COMP "CLK" SITE "58"; IOBUF PORT "CLK" IO_TYPE=LVCMOS33;
LOCATE COMP "SEL_LAT" SITE "59"; IOBUF PORT "SEL_LAT" IO_TYPE=LVCMOS33;
LOCATE COMP "SEL[0]" SITE "141"; IOBUF PORT "SEL[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "SEL[1]" SITE "136"; IOBUF PORT "SEL[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "SEL[2]" SITE "130"; IOBUF PORT "SEL[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "R[0]" SITE "138"; IOBUF PORT "R[0]" IO_TYPE=LVCMOS33;
