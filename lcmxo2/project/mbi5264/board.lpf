LOCATE COMP "B[0]" SITE "140"; IOBUF PORT "B[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "R[1]" SITE "142"; IOBUF PORT "R[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "G[1]" SITE "143"; IOBUF PORT "G[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "B[1]" SITE "137"; IOBUF PORT "B[1]" IO_TYPE=LVCMOS33;
